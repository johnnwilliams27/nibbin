{
  "name": "@trust-index/scoring",
  "version": "0.1.0",
  "description": "Deterministic scoring engine for the Agent Trust Index: pure functions from AgentSnapshot to ScoreResult, no I/O, no floating point.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "agent-trust": "./bin/agent-trust.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "golden:generate": "tsx scripts/generate-golden.ts"
  },
  "dependencies": {
    "@trust-index/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
