{
  "name": "@trust-index/db",
  "version": "0.1.0",
  "description": "Canonical store for the Agent Trust Index: Drizzle schema, migrations, chain seed, and the snapshot query layer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
