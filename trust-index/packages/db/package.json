    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
