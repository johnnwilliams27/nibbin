# Byte-for-byte copy of data/agents.json, written by scripts/prepare-data.mjs on
# every build (prebuild/predev) so the deployed site can serve the exact snapshot
# it was rendered from. It is ~7MB and fully derived, so it is generated at
# deploy time rather than duplicated in history.
public/data/agents.json

# Raw 8004scan API responses, cached so a rerun refetches nothing. 2,600+ files
# and ~43MB of regenerable data — the pipeline reproduces it from the documented
# queries in data/SUMMARY.md, so it has no business in history.
data/raw/
