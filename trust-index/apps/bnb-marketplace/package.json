{
  "name": "bnb-agent-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Measured agent marketplace for BNB Chain (ERC-8004). Separates what we measured from what the ecosystem claims.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:pipeline": "python -m unittest discover -s scripts -p test_*.py -v",
    "test:export": "node scripts/check-export.mjs",
    "prepare-data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare-data",
    "dev": "next dev",
    "prebuild": "npm run prepare-data",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.5",
    "lucide-react": "0.469.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.1.13",
    "typescript": "5.7.3"
  }
}
