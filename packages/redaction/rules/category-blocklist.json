{
  "comment": "Layer-2 category blocklist (C5: banking, health, and personal sites are never recorded) — SINGLE SOURCE OF TRUTH, embedded into the Rust daemon via include_str!. Evaluated BEFORE persistence: a hit drops the event entirely, recording nothing (not even a gap — a gap timestamped to a blocked category would itself leak that the user was there). Hosts match the registrable suffix; bundle ids match exact or prefix; title terms match case-insensitively. User-added exclusions extend this list at runtime and are stored locally.",
  "version": 1,
  "blockedCategories": ["banking", "health", "personal"],
  "matchers": {
    "banking": {
      "hosts": [
        "chase.com", "bankofamerica.com", "wellsfargo.com", "citi.com", "capitalone.com",
        "usbank.com", "pnc.com", "truist.com", "ally.com", "discover.com",
        "schwab.com", "fidelity.com", "vanguard.com", "etrade.com", "robinhood.com",
        "paypal.com", "venmo.com", "cash.app", "wise.com", "coinbase.com",
        "americanexpress.com", "synchrony.com", "sofi.com", "chime.com", "navyfederal.org",
        "creditkarma.com", "experian.com", "equifax.com", "transunion.com", "annualcreditreport.com",
        "irs.gov", "treasury.gov", "ssa.gov"
      ],
      "bundleIds": [
        "com.chase", "com.bankofamerica", "com.wellsfargo", "com.citi", "com.capitalone",
        "com.paypal", "com.venmo", "com.squareup.cash", "com.coinbase", "com.robinhood",
        "com.schwab", "com.fidelity", "com.intuit.turbotax", "com.intuit.quickbooks.banking",
        "com.apple.Passbook", "com.apple.PassKit"
      ],
      "titleTerms": [
        "online banking", "checking account", "savings account", "routing number",
        "wire transfer", "account balance", "credit card statement", "tax return"
      ]
    },
    "health": {
      "hosts": [
        "mychart.com", "mychart.org", "epic.com", "athenahealth.com", "zocdoc.com",
        "goodrx.com", "webmd.com", "drugs.com", "cvs.com", "walgreens.com",
        "optum.com", "uhc.com", "cigna.com", "aetna.com", "anthem.com", "kaiserpermanente.org",
        "healthcare.gov", "medicare.gov", "labcorp.com", "questdiagnostics.com",
        "talkspace.com", "betterhelp.com", "headspace.com", "psychologytoday.com",
        "23andme.com", "ancestry.com"
      ],
      "bundleIds": [
        "com.apple.Health", "com.apple.HealthKit", "org.mychart", "com.zocdoc",
        "com.goodrx", "com.teladoc", "com.betterhelp", "com.talkspace"
      ],
      "titleTerms": [
        "patient portal", "test results", "lab results", "prescription", "diagnosis",
        "medical record", "appointment with dr", "therapy session", "mental health"
      ]
    },
    "personal": {
      "hosts": [
        "tinder.com", "bumble.com", "hinge.co", "match.com", "okcupid.com", "grindr.com",
        "onlyfans.com", "pornhub.com", "xvideos.com"
      ],
      "bundleIds": [
        "com.tinder", "com.bumble.app", "co.hinge.app", "com.match", "com.okcupid.app",
        "com.grindrguy.grindrx", "com.apple.MobileSMS", "com.apple.iChat",
        "net.whatsapp.WhatsApp", "org.whispersystems.signal-desktop", "com.facebook.archon.developerID",
        "ru.keepcoder.Telegram", "org.telegram.desktop"
      ],
      "titleTerms": [
        "private browsing", "incognito", "personal journal", "diary"
      ]
    }
  }
}
