{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibbin",
  "version": "0.2.1",
  "identifier": "app.nibbin.observer",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nibbin",
        "label": "main",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://oaymttudfazqaqequrke.supabase.co https://nibbin.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nibbin"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["binaries/observerd*"],
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
