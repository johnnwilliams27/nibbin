{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibbin",
  "version": "0.1.0",
  "identifier": "app.nibbin.observer",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nibbin",
        "label": "main",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "visible": true
      }
    ],
    "trayIcon": {
      "id": "observer-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Nibbin"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://nibbin.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nibbin"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    }
  }
}
